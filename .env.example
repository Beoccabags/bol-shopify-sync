# Bol.com API Credentials
# Ophalen via Seller Dashboard > Instellingen > API Instellingen
BOL_CLIENT_ID=your_client_id
BOL_CLIENT_SECRET=your_client_secret

# Shopify API Credentials
# Private App aanmaken in Shopify Admin > Apps > Develop apps
SHOPIFY_SHOP=your-shop-name
SHOPIFY_ACCESS_TOKEN=your_access_token

# Shopify Product Variant ID voor prijsverschil product
# Format: gid://shopify/ProductVariant/xxxxx
BOL_PRIJSVERSCHIL_VARIANT_ID=gid://shopify/ProductVariant/xxxxx
