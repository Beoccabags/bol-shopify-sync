# Bol.com API Credentials
# Ophalen via Seller Dashboard > Instellingen > API Instellingen
BOL_CLIENT_ID=your_client_id
BOL_CLIENT_SECRET=your_client_secret

# Shopify API Credentials
# OAuth app aanmaken in Shopify Admin > Apps > Develop apps
SHOPIFY_SHOP=your-shop-name
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret

# Shopify Product Variant ID voor prijsverschil product
# Format: gid://shopify/ProductVariant/xxxxx
BOL_PRIJSVERSCHIL_VARIANT_ID=gid://shopify/ProductVariant/xxxxx


# ---------------------------------------------------------------------------
# Voorraadsync (Shopify -> Bol.com)
# ---------------------------------------------------------------------------

# Uur vanaf wanneer de voorraadsync draait binnen "node index.js all".
# Hij draait dan één keer per dag (bijgehouden in daily-state.json).
# Zet TZ=Europe/Amsterdam als je Nederlandse tijd wilt aanhouden.
STOCK_SYNC_HOUR=6

# Optioneel: alleen de voorraad van deze locatie gebruiken.
# Leeg = totale beschikbare voorraad over alle locaties.
# Format: gid://shopify/Location/xxxxx
SHOPIFY_LOCATION_ID=

# Veiligheidsmarge: dit aantal wordt van de Shopify voorraad afgetrokken
BOL_STOCK_BUFFER=0

# Maximale voorraad die naar Bol.com gestuurd wordt (Bol staat max. 999 toe)
BOL_STOCK_MAX=999

# true = Shopify is leidend voor de voorraad (aanbevolen)
BOL_STOCK_MANAGED_BY_RETAILER=true

# true = offers waarvan de EAN niet in Shopify staat op 0 zetten
BOL_STOCK_MISSING_TO_ZERO=false

# Pauze in ms tussen voorraad-updates (rate limit Bol.com)
BOL_STOCK_DELAY_MS=250

# true = alleen loggen wat er zou gebeuren, niets versturen
BOL_STOCK_DRY_RUN=false


# ---------------------------------------------------------------------------
# Verzendsync / tracking (Shopify -> Bol.com)
# ---------------------------------------------------------------------------

# Tag waarmee de ordersync bol-orders markeert
SHOPIFY_BOL_TAG=bol

# Tag die wordt toegevoegd zodra alles bij Bol.com is gemeld
SHOPIFY_SHIPPED_TAG=bol-verzonden

# Aantal dagen dat teruggekeken wordt naar afgehandelde orders
TRACKING_LOOKBACK_DAYS=14

# true = ook melden zonder trackingnummer
TRACKING_ALLOW_EMPTY=false

# true = alleen loggen wat er zou gebeuren, niets versturen
TRACKING_DRY_RUN=false

# Fallback transporter code als de vervoerder niet herkend wordt
BOL_DEFAULT_TRANSPORTER=OTHER

# Optioneel: eigen vertaling van Shopify vervoerder naar Bol.com code
# BOL_TRANSPORTER_MAP={"Mijn Vervoerder":"TNT"}


# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------

# Aantal dagen dat gearchiveerde logs in logs/ bewaard blijven
LOG_RETENTION_DAYS=30
